import os
from glob import glob
from setuptools import find_packages, setup

package_name = 'dynamixel_control'

setup(
    name=package_name,
    version='0.0.0',
    packages=find_packages(exclude=['test']),
    data_files=[
        ('share/ament_index/resource_index/packages',
            ['resource/' + package_name]),
        ('share/' + package_name, ['package.xml']),
        (os.path.join('share',package_name,'launch'), glob(os.path.join('launch','*launch.[pxy][yma]*'))),
        ('share/' + package_name + '/urdf', glob('urdf/*')),
        ('share/' + package_name + '/action', glob('action/*.action')),
    ],
    install_requires=['setuptools', 'opencv-python', 'cv-bridge', 'python-chess'],
    zip_safe=True,
    maintainer='shin',
    maintainer_email='shin@todo.todo',
    description='TODO: Package description',
    license='TODO: License declaration',
    extras_require={
        'test': [
            'pytest',
        ],
    },
    entry_points={
        'console_scripts': [
            # Motor/Arm control nodes
            'motor_node = dynamixel_control.motor_node:main',
            'motor_publisher = dynamixel_control.motor_publisher:main',
            'chess_mapper = dynamixel_control.chess_mapper:main',
            
            # Vision and detection nodes
            'camera_node = dynamixel_control.camera_node:main',
            'camera_bridge_node = dynamixel_control.camera_bridge_node:main',
            'timer_node = dynamixel_control.timer_node:main',
            'timer_client = dynamixel_control.timer_client:main',
            
            # Main AI brain
            'chess_brain = dynamixel_control.chess_brain:main',
            
            # Visualization
            'rviz_bridge = dynamixel_control.rviz_bridge:main',
        ],
    },
)
